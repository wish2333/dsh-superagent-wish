{
  "name": "@wish2333/dsh-superagent-wish",
  "version": "0.1.0",
  "description": "Personal super-agent preset for DeepSeek Harness — Partner talks with wish and dispatches work to Workers, each working unit keeps its own state and inputs.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./partner": "./partner.js",
    "./secretary": "./secretary.js",
    "./sessions": "./sessions.js",
    "./worker": "./worker.js",
    "./worker-discoverer": "./worker-discoverer.js",
    "./worker-implementer": "./worker-implementer.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./relay": "./relay.js"
  },
  "files": [
    "index.js",
    "state.js",
    "schema.js",
    "working-units.js",
    "relay.js",
    "sessions.js",
    "partner.js",
    "secretary.js",
    "worker.js",
    "worker-discoverer.js",
    "worker-implementer.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "agent-preset"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/"
  }
}
